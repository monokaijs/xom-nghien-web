{
  "name": "@xom/launcher",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "vite build",
    "desktop:build": "tauri build --config src-tauri/tauri.local.conf.json",
    "standalone:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-standalone.ps1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist src-tauri/target"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tabler/icons-react": "^3.35.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-deep-link": "^2.4.5",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  }
}
